# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored and read automatically by Next.js on the server.

# --- OpenAI ---
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone ---
# Create a project + API key at https://app.pinecone.io
# We'll create the index programmatically in Phase 5; put its name here.
PINECONE_API_KEY=pc-...
PINECONE_INDEX=rag-agent
# Free Starter tier is AWS us-east-1 only; leave these unless you're on a paid tier.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
