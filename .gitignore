# dependencies
/node_modules
.yarn/*
!.yarn/patches
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# typescript incremental build cache (tsconfig.json sets incremental: true).
# A stale copy makes `yarn typecheck` report a false pass — never commit it.
tsconfig.tsbuildinfo

# env — NEVER commit real keys
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea
